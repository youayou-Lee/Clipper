#!/bin/sh
# 铁律:测试红不 push。返回非零即中止 push(勿用 --no-verify 绕过)。
echo "[pre-push] 运行全量测试..."

# 判定:pytest 正常结束时输出必含 "N passed/failed/no tests ran";
# 若连 "passed|failed|no tests ran" 都没有,说明是 uv/环境本身失败(如断网、lock 过期),
# 两种失败语义分开提示,避免误诊。
run_and_judge() {
  out=$("$@" 2>&1)
  rc=$?
  echo "$out"
  if printf '%s' "$out" | grep -qE '[0-9]+ (passed|failed)|no tests ran'; then
    if printf '%s' "$out" | grep -qE '[1-9][0-9]* failed| error'; then
      echo "[pre-push] ✗ 测试红($RC_HINT),push 已拒绝。先修绿再推。"
    else
      echo "[pre-push] ✓ 测试全绿,放行"
      return 0
    fi
  else
    echo "[pre-push] ✗ 测试未能运行(uv/环境失败,非测试红)。"
    echo "[pre-push]   若提示 lock 过期先跑: uv sync;网络问题检查代理。"
  fi
  return 1
}

RC_HINT=""
if command -v uv >/dev/null 2>&1; then
  RC_HINT="pytest 经 uv run --locked"
  run_and_judge uv run --locked pytest tests/ -q
  exit $?
fi

RC_HINT="pytest(回退路径)"
if [ -x .venv/bin/pytest ]; then
  # POSIX 路径回退;Windows 由 uv 分支覆盖(git-bash 下也走 uv)
  run_and_judge .venv/bin/pytest tests/ -q
  exit $?
fi

echo "[pre-push] ✗ 找不到 uv 或 .venv,无法验证测试,push 已拒绝。先安装 uv 或: uv sync"
exit 1
