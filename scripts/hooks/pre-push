#!/bin/sh
# 铁律:测试红不 push。返回非零即中止 push(勿用 --no-verify 绕过)。
echo "[pre-push] 运行全量测试..."
if command -v uv >/dev/null 2>&1; then
  uv run pytest tests/ -q 2>&1 || {
    echo "[pre-push] ✗ 测试红,push 已拒绝。先修绿再推。"
    exit 1
  }
elif [ -x .venv/bin/pytest ]; then
  .venv/bin/pytest tests/ -q 2>&1 || {
    echo "[pre-push] ✗ 测试红,push 已拒绝。先修绿再推。"
    exit 1
  }
else
  echo "[pre-push] ✗ 找不到 uv 或 .venv,无法验证测试,push 已拒绝。"
  exit 1
fi
echo "[pre-push] ✓ 测试全绿,放行"
