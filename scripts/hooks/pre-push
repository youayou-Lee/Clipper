#!/bin/sh
# 铁律:测试红不 push。返回非零即中止 push(勿用 --no-verify 绕过)。
echo "[pre-push] 运行全量测试..."

# 判定铁律:退出码非零一律拒绝;pytest 输出特征只用来选提示语(测试红 vs 环境失败)。
# pytest 结束统计形如 "N passed / M failed / K error / no tests ran"(中断为 "interrupted")。
run_and_judge() {
  out=$("$@" 2>&1)
  rc=$?
  printf '%s\n' "$out"
  if [ "$rc" -ne 0 ]; then
    if printf '%s' "$out" | grep -qE '[0-9]+ (passed|failed)|[0-9]+ error|no tests ran|interrupted'; then
      echo "[pre-push] ✗ 测试未通过,push 已拒绝。先修绿再推。"
    else
      echo "[pre-push] ✗ 测试未能运行(uv/环境失败,非测试红)。"
      echo "[pre-push]   若提示 lock 过期先跑: uv lock && uv sync;网络问题检查代理。"
    fi
    return 1
  fi
  if printf '%s' "$out" | grep -qE '[1-9][0-9]* passed'; then
    echo "[pre-push] ✓ 测试全绿,放行"
    return 0
  fi
  echo "[pre-push] ✗ 退出码 0 但未见测试统计(异常,如 0 个测试),push 已拒绝。"
  return 1
}

if command -v uv >/dev/null 2>&1; then
  run_and_judge uv run --locked pytest tests/ -q
  exit $?
fi

# .venv 回退仅 POSIX(Windows 有 uv,git-bash 下同样命中 uv 分支)
if [ -x .venv/bin/pytest ]; then
  run_and_judge .venv/bin/pytest tests/ -q
  exit $?
fi

echo "[pre-push] ✗ 找不到 uv 或 .venv,无法验证测试,push 已拒绝。先安装 uv 或: uv sync"
exit 1
